<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>zip</string>
				<string>zipx</string>
				<string>7z</string>
				<string>rar</string>
				<string>tar</string>
				<string>gz</string>
				<string>xz</string>
				<string>bz2</string>
				<string>iso</string>
				<string>tgz</string>
				<string>tbz</string>
				<string>tbz2</string>
				<string>txz</string>
				<string>001</string>
				<string>z01</string>
				<string>r00</string>
				<string>zst</string>
				<string>cab</string>
				<string>dmg</string>
				<string>wim</string>
				<string>jar</string>
				<string>apk</string>
			</array>
		</dict>
	</array>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>使用 F7Zip 打开</string>
			</dict>
			<key>NSMessage</key>
			<string>performFinderAction</string>
			<key>NSUserData</key>
			<string>open</string>
			<key>NSPortName</key>
			<string>F7Zip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.archive</string>
				<string>public.disk-image</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>浏览所选压缩包的文件树</string>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>压缩为 ZIP（F7Zip）</string>
			</dict>
			<key>NSMessage</key>
			<string>performFinderAction</string>
			<key>NSUserData</key>
			<string>compressZip</string>
			<key>NSPortName</key>
			<string>F7Zip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>直接在所选项目旁创建 ZIP 压缩包</string>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>解压到当前文件夹（F7Zip）</string>
			</dict>
			<key>NSMessage</key>
			<string>performFinderAction</string>
			<key>NSUserData</key>
			<string>extractHere</string>
			<key>NSPortName</key>
			<string>F7Zip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.archive</string>
				<string>public.disk-image</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>直接解压到压缩包所在文件夹，重名文件不会覆盖</string>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>解压到…（F7Zip）</string>
			</dict>
			<key>NSMessage</key>
			<string>performFinderAction</string>
			<key>NSUserData</key>
			<string>extractTo</string>
			<key>NSPortName</key>
			<string>F7Zip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.archive</string>
				<string>public.disk-image</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>选择目标文件夹后解压，支持加密压缩包</string>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>使用 F7Zip 压缩</string>
			</dict>
			<key>NSMessage</key>
			<string>performFinderAction</string>
			<key>NSUserData</key>
			<string>compress</string>
			<key>NSPortName</key>
			<string>F7Zip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>将所选文件和文件夹创建为 ZIP 或 7z 压缩包</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.7-zip.7-zip-archive</string>
			<key>UTTypeDescription</key>
			<string>7-Zip archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>7z</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.rarlab.rar-archive</string>
			<key>UTTypeDescription</key>
			<string>RAR archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rar</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
